# Dropbox app credentials (https://www.dropbox.com/developers/apps → your app → Settings)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Long-lived refresh token. Generate once with:  npm run auth
# The server exchanges this for short-lived access tokens automatically.
DROPBOX_REFRESH_TOKEN=

# --- Optional ---
# Static access token instead of the refresh flow (expires in ~4h, not recommended).
# DROPBOX_ACCESS_TOKEN=

# Team apps only: act as a specific team member / admin (member id like "dbmid:...").
# Leave unset for a normal user-scoped app authorized by the team member.
# DROPBOX_SELECT_USER=
# DROPBOX_SELECT_ADMIN=

# Which namespace paths are relative to (Business team accounts):
#   root (default) -> team space root, so team folders like "/Client work" are visible
#   home           -> only your personal home folder (team folders hidden)
#   <numeric id>   -> a specific namespace id
# Under "root", your personal files live under "/<Your Name>" (e.g. "/Jane Doe").
# DROPBOX_PATH_ROOT=root

# Comma-separated modules to NOT register, e.g. "sharing". See src/index.ts.
# DROPBOX_DISABLED_MODULES=

# Safety cap (bytes) for dropbox_read_file. Default 5 MB.
# DROPBOX_MAX_READ_BYTES=5242880

# Chunk size (bytes) for large-file upload sessions. Default 64 MB, min 4 MB,
# max 150 MB per chunk. Use a multiple of 4 MB.
# DROPBOX_UPLOAD_CHUNK_BYTES=67108864
