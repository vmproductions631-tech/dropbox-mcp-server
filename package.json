{
  "name": "dropbox-mcp",
  "version": "0.1.0",
  "description": "MCP server for Dropbox (Business/Team): file management, search, shared links, and document reference.",
  "type": "module",
  "bin": {
    "dropbox-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
